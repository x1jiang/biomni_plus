# =====================================================================
# Biomni-Plus Configuration (.env.example)
# =====================================================================

# Primary Model Provider: "openai", "gemini", "anthropic", "bedrock"
PROVIDER=openai

# Model Name: e.g. "gpt-5.6-luna", "gpt-4o", "claude-3-7-sonnet", "gemini-3.1-flash"
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Gemini API Key
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: Anthropic API Key
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: NCBI E-utilities API Key (for higher rate limits on PubMed/BLAST)
# NCBI_API_KEY=your_ncbi_api_key_here

# Optional: Local Data Lake Path (defaults to ./data)
# BIOMNI_DATA_PATH=./data

# Optional: private OpenAI-compatible model (Muse-Glimmer-30B, vLLM, etc.)
# Do not commit a real host. Example placeholder:
# GLIMMER_30B_BACKEND=http://xxx.xx.xx.xx/v1
# GLIMMER_30B_MODEL=Muse-Glimmer-30B
# GLIMMER_API_KEY=not-needed

# Performance & Telemetry Flags
STREAMING=1
CONTEXT_WINDOW=1000000
MAX_ITERATIONS=30
CLAW_TRAJECTORY=1
CLAW_LEARN=0
